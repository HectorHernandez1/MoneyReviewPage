# Database Configuration (the backend reads these discrete DB_* variables)
DB_NAME=database_name
DB_USER=username
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# AI Chatbot Configuration
# Provider: anthropic (default), openai, deepseek, or glm
LLM_PROVIDER=anthropic
# Optional model override. Defaults per provider:
#   anthropic: claude-sonnet-5 | openai: gpt-5.6-luna
#   deepseek: deepseek-v4-flash | glm: glm-5.2
# LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# GLM_API_KEY=your-zai-key-here
