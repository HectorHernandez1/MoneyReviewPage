# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Example:
# DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/budget_db

# AI Chatbot Configuration
# Provider: anthropic (default), openai, deepseek, or glm
LLM_PROVIDER=anthropic
# Optional model override. Defaults per provider:
#   anthropic: claude-sonnet-5 | openai: gpt-5.6-luna
#   deepseek: deepseek-v4-flash | glm: glm-5.2
# LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# GLM_API_KEY=your-zai-key-here
